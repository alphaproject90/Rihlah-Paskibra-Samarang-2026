DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rihlah

# DIRECT_URL dipakai khusus untuk `prisma migrate` (bukan runtime aplikasi).
# Kalau pakai Supabase: pooled connection (port 6543) untuk DATABASE_URL,
# direct connection (port 5432) untuk DIRECT_URL. Lihat SETUP_SUPABASE.md.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/rihlah

# JWT_SECRET WAJIB diatur di production! Gunakan nilai yang kuat dan random.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# PANITIA_USERNAME dan PANITIA_PASSWORD_HASH WAJIB diatur! Jika salah satu kosong,
# login panitia akan ditolak dengan error 500 (tidak ada fallback default).
# Akun panitia bersifat satu akun bersama (bukan per-orang).
PANITIA_USERNAME=panitia
# Generate hash dengan: node -e "require('bcryptjs').hash(process.argv[1], 10).then(h => console.log(h))" PASSWORD_ANDA
PANITIA_PASSWORD_HASH=your-bcryptjs-hashed-password-here

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
