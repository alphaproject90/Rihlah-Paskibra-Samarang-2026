DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rihlah

# JWT_SECRET WAJIB diatur di production! Gunakan nilai yang kuat dan random.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# PANITIA_PIN_HASH WAJIB diatur! Jika kosong, login panitia akan ditolak dengan error 500.
# Generate dengan: node -e "require('bcryptjs').hash(process.argv[1], 10).then(h => console.log(h))" YOUR_PIN
# Contoh untuk PIN 1945: node -e "require('bcryptjs').hash('1945', 10).then(h => console.log(h))"
PANITIA_PIN_HASH=your-bcryptjs-hashed-pin-here

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
