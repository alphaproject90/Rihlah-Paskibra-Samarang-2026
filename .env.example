# DATABASE_URL dipakai oleh runtime aplikasi serverless.
# Jika menggunakan connection pooler (mis. Supabase PgBouncer port 6543 atau Neon pooled):
# Tambahkan ?pgbouncer=true&connection_limit=1 untuk mencegah connection exhaustion di serverless.
# Contoh: postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rihlah

# DIRECT_URL dipakai khusus untuk `prisma migrate` (bukan runtime aplikasi).
# Selalu gunakan direct connection (port 5432) tanpa pooler.
# Contoh: postgresql://postgres.xxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/rihlah

# JWT_SECRET WAJIB diatur di production! Gunakan nilai yang kuat dan random.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-secret-here

# PANITIA_USERNAME dan PANITIA_PASSWORD_HASH WAJIB diatur! Jika salah satu kosong,
# login panitia akan ditolak dengan error 500 (tidak ada fallback default).
# Akun panitia bersifat satu akun bersama (bukan per-orang).
PANITIA_USERNAME=panitia
# Generate hash dengan: node -e "require('bcryptjs').hash(process.argv[1], 10).then(h => console.log(h))" PASSWORD_ANDA
PANITIA_PASSWORD_HASH=your-bcryptjs-hashed-password-here

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# OTP_ENCRYPTION_KEY WAJIB diatur di production! Dipakai untuk enkripsi AES-256-GCM
# dan keyed-hash HMAC-SHA256 pada fitur reset password via OTP WhatsApp (wa.me).
# Jika kosong atau kurang dari 32 karakter, endpoint request-otp/verify-otp-reset/
# panitia-get-wa-link akan menolak dengan error 500 (fail-fast, tidak ada fallback).
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_ENCRYPTION_KEY=your-random-64-char-hex-key-here
