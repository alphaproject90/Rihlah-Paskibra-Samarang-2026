{
  "framework": "vite",
  "buildCommand": "prisma generate && vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/panitia/ganti-password",
      "destination": "/api/auth/ganti-password?target=panitia"
    },
    {
      "source": "/api/kegiatan/absen",
      "destination": "/api/peserta?resource=absen_kegiatan"
    },
    {
      "source": "/api/kegiatan",
      "destination": "/api/peserta?resource=kegiatan"
    },
    {
      "source": "/api/peserta/dokumen-upload",
      "destination": "/api/dokumen/upload"
    },
    {
      "source": "/api/peserta/publik",
      "destination": "/api/peserta?resource=publik"
    },
    {
      "source": "/api/peserta/bukti-pendaftaran",
      "destination": "/api/peserta?resource=bukti_pendaftaran"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(self)"
        }
      ]
    }
  ]
}