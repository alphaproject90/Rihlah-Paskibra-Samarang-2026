generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum role untuk sistem multi-panitia (Tahap 1)
enum RolePanitia {
  SUPER_ADMIN
  ADMIN_MOBIL
}

// Model akun panitia individual (Tahap 1)
// Menggantikan sistem akun tunggal berbasis env-var secara bertahap (zero-downtime).
// Super Admin: akses penuh ke semua data & manajemen akun.
// Admin Mobil: hanya bisa lihat & scan peserta di mobilnya sendiri.
model Panitia {
  id            String      @id @default(cuid())
  username      String      @unique
  passwordHash  String
  namaLengkap   String
  role          RolePanitia
  mobil         String?     // Wajib diisi jika role=ADMIN_MOBIL, null untuk SUPER_ADMIN
  aktif         Boolean     @default(true)
  createdBy     String?     // username Super Admin yang membuat akun ini (null jika di-migrasi dari env)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([username])
  @@index([role])
}

model Peserta {
  id              String    @id @default(cuid())
  idPeserta       String    @unique // format: PASK-XXXX / TIDAK-IKUT
  namaLengkap     String
  jenisKelamin    String
  asalSekolah     String
  partisipasi     String    // "Ikut" | "Tidak Ikut"
  alasanTidakIkut String?
  waPribadi       String?
  waDarurat       String?
  riwayatMedis    String?
  mobil           String?   // Nama mobil rombongan peserta (Tahap 1) — nullable, diisi manual panitia
  waktuBerangkat  DateTime?
  waktuPulang     DateTime?
  username        String?   @unique
  passwordHash    String?
  statusPassword  String?   // "Wajib Ganti" | "Selesai"
  createdAt       DateTime  @default(now())
  deletedAt       DateTime? // Soft delete untuk audit & keamanan data (Tahap 5)
  logs            LogScan[]
  dokumen         Dokumen[]
  resetRequests   ResetPasswordRequest[]
  absenKegiatan   AbsenKegiatan[]

  @@index([deletedAt])
}

model ResetPasswordRequest {
  id           String    @id @default(cuid())
  idPeserta    String
  peserta      Peserta   @relation(fields: [idPeserta], references: [idPeserta], onDelete: Cascade)
  nama         String
  noWaTujuan   String    // Nomor WA terdaftar di database (waPribadi / waDarurat)
  otpHash      String    // Keyed-hash HMAC-SHA256 untuk verifikasi aman anti brute-force offline
  otpEncrypted String    // Terenkripsi AES-256-GCM dengan OTP_ENCRYPTION_KEY untuk dekripsi link panitia
  status       String    @default("PENDING") // "PENDING" | "SENT" | "USED" | "EXPIRED" | "CANCELLED"
  attempts     Int       @default(0)         // Counter salah tebak OTP (maksimal 3 kali)
  expiresAt    DateTime  // Batas kedaluwarsa OTP (10 menit sejak panitia membuat/mengirim)
  sentAt       DateTime? // Waktu panitia mengklik tombol buka link WhatsApp
  sentBy       String?   // Username panitia yang mengirimkan pesan
  usedAt       DateTime? // Waktu peserta berhasil memverifikasi OTP dan password baru
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([idPeserta])
  @@index([status])
  @@index([expiresAt])
}

model LogScan {
  id         String   @id @default(cuid())
  waktuScan  DateTime @default(now())
  idPeserta  String
  nama       String
  keterangan String   // "Registrasi Ulang" | "Scan Keberangkatan" | "Scan Kepulangan dari Lokasi" | "Scan Tiba di Rumah"
  peserta    Peserta  @relation(fields: [idPeserta], references: [idPeserta])
}

// Model sesi kegiatan lapangan untuk presensi terpisah (Tahap 3)
model Kegiatan {
  id          String          @id @default(cuid())
  nama        String
  deskripsi   String?
  aktif       Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  absen       AbsenKegiatan[]

  @@index([aktif])
}

// Log presensi kehadiran per peserta per kegiatan lapangan (Tahap 3)
model AbsenKegiatan {
  id          String    @id @default(cuid())
  kegiatanId  String
  kegiatan    Kegiatan  @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  idPeserta   String
  peserta     Peserta   @relation(fields: [idPeserta], references: [idPeserta], onDelete: Cascade)
  waktuAbsen  DateTime  @default(now())
  dicatatOleh String?   // username panitia yang mencatat presensi hadir

  @@unique([kegiatanId, idPeserta])
  @@index([kegiatanId])
  @@index([idPeserta])
}

// Model baru untuk mencatat aktivitas sistem
model SystemLog {
  id        String   @id @default(cuid())
  level     String   // "INFO" | "WARN" | "ERROR" | "CRITICAL"
  action    String   // Contoh: "LOGIN_FAILED", "SCAN_INVALID", "API_ERROR"
  actorId   String?  // ID Peserta atau Panitia yang melakukan aksi (jika ada)
  details   Json?    // Menyimpan data dinamis (pesan error, payload)
  ipAddress String?  // Menyimpan IP untuk melacak spammer/hacker
  createdAt DateTime @default(now())
}

model Dokumen {
  id              String   @id @default(cuid())
  judul           String
  scope           String   // "GLOBAL" | "PERSONAL"
  idPeserta       String?  // wajib diisi jika scope="PERSONAL", null jika "GLOBAL"
  peserta         Peserta? @relation(fields: [idPeserta], references: [idPeserta])
  blobUrl         String
  blobDownloadUrl String
  blobPathname    String   // dibutuhkan untuk del() saat hapus dokumen
  ukuranByte      Int?
  diunggahOleh    String?  // username panitia yang upload, untuk audit trail
  createdAt       DateTime @default(now())

  @@index([scope])
  @@index([idPeserta])
}

model Pengaturan {
  id                  String   @id @default("singleton")
  pendaftaranDibuka   Boolean  @default(true)
  panitiaPasswordHash String?  // Hash password panitia hasil rotasi via antarmuka admin
  updatedAt           DateTime @updatedAt
  updatedOleh         String?  // username/role panitia yang terakhir mengubah, untuk audit
}
